### Environment Application Settings
APP_NAME="CyberApp API Core"
APP_VERSION=1.0.0
APP_ENV=dev ### dev | prod
APP_DEBUG=true
APP_URL=http://localhost/cyberrestapi
CORS_ORIGIN=*
VIEW_PATH=Views
RATE_LIMIT=120
RATE_LIMIT_WINDOW=60
LOG_RETENTION_DAYS=14
UPLOAD_MAX_KB=2048
UPLOAD_DIR=uploads

### Database Configuration
### migration / install รองรับเฉพาะ mysql | mariadb
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberfastapi
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

### Security Settings
### สร้างด้วย php deawx key:generate
ENCRYPTION_KEY=
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
SESSION_PREFIX=app_
